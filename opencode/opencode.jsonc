{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "username": "aefly",
    "default_agent": "plan",
    "model": "opencode/deepseek-v4-flash-free",
    "small_model": "opencode/deepseek-v4-flash-free",
    "agent": {
        "build": {
            "permission": {
                "*": "ask",
                "read": {
                    "*": "allow",
                    "*.env": "deny",
                    "*.env.*": "deny",
                    "*.env.example": "allow",
                },
                "edit": {
                    "*": "ask",
                    "*.env": "deny",
                    "*.env.*": "deny",
                },
                "glob": "allow",
                "grep": "allow",
                "webfetch": "allow",
                "external_directory": "ask",
                "bash": {
                    "*": "ask",

                    "date": "allow",
                    "git status": "allow",
                    "git status *": "allow",
                    "git diff": "allow",
                    "git diff *": "allow",
                    "git log": "allow",
                    "git log *": "allow",
                    "ls": "allow",
                    "ls -la": "allow",
                    "pwd": "allow",
                    "echo": "allow",

                    "head *": "allow",
                    "cat *": "allow",
                    "tail *": "allow",

                    "cat *.env": "deny",
                    "cat *.env.*": "deny",
                    "head *.env": "deny",
                    "head *.env.*": "deny",
                    "tail *.env": "deny",
                    "tail *.env.*": "deny",
                },
            },
        },
        "plan": {
            "permission": {
                "*": "ask",
                "read": {
                    "*": "allow",
                    "*.env": "deny",
                    "*.env.*": "deny",
                    "*.env.example": "allow",
                },
                "edit": "deny",
                "glob": "allow",
                "grep": "allow",
                "webfetch": "allow",
                "external_directory": "ask",
                "bash": {
                    "*": "ask",

                    "date": "allow",
                    "git status": "allow",
                    "git status *": "allow",
                    "git diff": "allow",
                    "git diff *": "allow",
                    "git log": "allow",
                    "git log *": "allow",
                    "ls": "allow",
                    "ls -la": "allow",
                    "pwd": "allow",
                    "echo": "allow",

                    "head *": "allow",
                    "cat *": "allow",
                    "tail *": "allow",

                    "cat *.env": "deny",
                    "cat *.env.*": "deny",
                    "head *.env": "deny",
                    "head *.env.*": "deny",
                    "tail *.env": "deny",
                    "tail *.env.*": "deny",
                },
            },
        },
    },
}
