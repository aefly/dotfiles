{
    /* UI & Appearance */
    "ui_font_size": 16,
    "buffer_font_family": "JetBrains Mono",
    "buffer_font_size": 14.0,
    "buffer_font_features": {
        "calt": true
    },
    "icon_theme": "Material Icon Theme",
    "theme": {
        "mode": "dark",
        "light": "Orng Light",
        "dark": "Orng Dark"
    },
    "theme_overrides": {
        "Orng Dark": {
            "syntax": {
                "comment": { "font_style": "italic" },
                "comment.doc": { "font_style": "italic" }
            }
        }
    },
    "project_panel": {
        "dock": "left"
    },

    /* UI Panels & Buttons */
    "tab_bar": {
        "show_tab_bar_buttons": false,
        "show_nav_history_buttons": false
    },
    "title_bar": {
        "show_onboarding_banner": false
    },
    "collaboration_panel": { "button": false },
    "debugger": { "button": false },
    "diagnostics": {
        "button": false,
        "include_warnings": true,
        "inline": {
            "enabled": true
        }
    },

    /* AI */
    "agent": {
        "threads_sidebar": {
            "position": "left"
        },
        "dock": "right",
        "notify_when_agent_waiting": "never",
        "enable_feedback": false,
        "default_profile": "write",
        "commit_message_instructions": "Use the Conventional Commits format: <type>(<scope>): <description>. Wrap code identifiers in backticks",
        "commit_message_model": {
            "provider": "openrouter",
            "model": "poolside/laguna-s-2.1:free",
            "effort": "low"
        }
    },
    "edit_predictions": {
        "allow_data_collection": "no",
        "provider": "copilot"
    },

    /* WSL */
    "wsl_connections": [
        {
            "distro_name": "Debian",
            "user": "aefly",
            "projects": []
        }
    ],

    /* Terminal */
    "terminal": {
        "font_family": "JetBrainsMono Nerd Font Mono"
    },

    /* Session & Startup */
    "restore_on_startup": "launchpad",
    "session": {
        "trust_all_worktrees": true
    },

    /* Telemetry */
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    }
}
